# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=https://mabitechsofts77.vercel.app
APP_URL=https://mabitechsofts77.vercel.app

# Database
DATABASE_URL=postgresql://techplatform:techplatform@localhost:5436/techplatform?schema=public

# Redis (required in production)
REDIS_URL=redis://localhost:6381

# Auth.js / NextAuth
AUTH_SECRET=generate-a-long-random-secret-at-least-32-chars
AUTH_URL=http://localhost:3000

# API JWT (Flutter)
JWT_ACCESS_SECRET=generate-another-long-random-secret
JWT_REFRESH_SECRET=generate-a-third-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Extra CORS origins for Flutter web / external clients (comma-separated).
# In development, http://localhost:* and http://127.0.0.1:* are allowed automatically.
# CORS_ORIGINS=http://localhost:6341,https://app.example.com

# Seed super admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMeImmediately1!
SEED_ADMIN_NAME=Super Admin

# Storage: local (default for development) or s3
STORAGE_DRIVER=local

# S3-compatible storage (MinIO / AWS / R2) — set STORAGE_DRIVER=s3 to use
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=techplatform-files
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=

# Cloudinary (images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ClamAV
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_ENABLED=true

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Tech Platform <noreply@example.com>"

# Firebase Cloud Messaging (JSON string or path)
FIREBASE_SERVICE_ACCOUNT=

# Payments — Chapa
CHAPA_SECRET_KEY=
CHAPA_PUBLIC_KEY=
CHAPA_WEBHOOK_SECRET=
CHAPA_BASE_URL=https://api.chapa.co/v1

# Payments — Telebirr
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_PUBLIC_KEY=
TELEBIRR_SHORT_CODE=
TELEBIRR_NOTIFY_URL=
TELEBIRR_BASE_URL=

# Cron / internal jobs
CRON_SECRET=generate-a-cron-secret

# Upload defaults (overridable in SiteSettings)
MAX_UPLOAD_BYTES=524288000

# Remote app policy (force-update URL, announcements, languages) is managed in
# Admin → App Settings / Homepage Manager and served via GET /api/v1/app/settings.
# Set FIREBASE_SERVICE_ACCOUNT to a JSON string for FCM (never commit the file).
