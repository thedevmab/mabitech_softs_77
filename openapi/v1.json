{
  "openapi": "3.0.3",
  "info": {
    "title": "Daily Tips Flutter API",
    "version": "1.0.0",
    "description": "Versioned REST API for the Daily Tips Flutter mobile client. Responses use `{ data }` on success and `{ error: { code, message } }` on failure. Post payloads include `readingTimeMinutes`. Clients should send a stable `eventKey` for idempotent post views."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {}
            },
            "required": [
              "code",
              "message"
            ]
          }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          }
        }
      },
      "AuthTokens": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresIn": {
            "type": "integer"
          },
          "refreshToken": {
            "type": "string"
          },
          "refreshTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string"
          },
          "image": {
            "type": "string",
            "nullable": true
          },
          "bio": {
            "type": "string",
            "nullable": true
          },
          "isPremium": {
            "type": "boolean"
          },
          "premiumExpiresAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "emailVerified": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PostFile": {
        "type": "object",
        "nullable": true,
        "properties": {
          "name": { "type": "string" },
          "extension": { "type": "string" },
          "mimeType": { "type": "string" },
          "sizeBytes": { "type": "integer" },
          "isApk": { "type": "boolean" },
          "downloadCount": { "type": "integer" },
          "apk": {
            "type": "object",
            "nullable": true,
            "properties": {
              "packageName": { "type": "string", "nullable": true },
              "versionName": { "type": "string", "nullable": true },
              "versionCode": { "type": "integer", "nullable": true },
              "minSdkVersion": { "type": "integer", "nullable": true }
            }
          }
        }
      },
      "Post": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "slug": { "type": "string" },
          "excerpt": { "type": "string", "nullable": true },
          "content": { "type": "string" },
          "featuredImage": { "type": "string", "nullable": true },
          "deliveryType": {
            "type": "string",
            "enum": ["none", "file", "link"]
          },
          "externalUrl": { "type": "string", "nullable": true },
          "linkDescription": { "type": "string", "nullable": true },
          "version": { "type": "string", "nullable": true },
          "publisher": { "type": "string", "nullable": true },
          "releaseDate": { "type": "string", "format": "date-time", "nullable": true },
          "file": { "$ref": "#/components/schemas/PostFile" },
          "readingTimeMinutes": { "type": "integer" },
          "isFeatured": { "type": "boolean" },
          "isSponsored": { "type": "boolean" }
        }
      }
    }
  },
  "paths": {
    "/auth/register": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Register a new user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registered"
          },
          "409": {
            "description": "Email taken",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Login and receive JWT tokens",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Revoke a refresh token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "refreshToken": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Logged out"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Rotate refresh token and issue a new access token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "refreshToken"
                ],
                "properties": {
                  "refreshToken": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tokens rotated"
          },
          "401": {
            "description": "Invalid refresh token"
          }
        }
      }
    },
    "/auth/forgot-password": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Request a password reset email",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Always succeeds (no enumeration)"
          }
        }
      }
    },
    "/auth/reset-password": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Reset password with email token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "token",
                  "password"
                ],
                "properties": {
                  "token": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password updated"
          },
          "400": {
            "description": "Invalid token"
          }
        }
      }
    },
    "/posts": {
      "get": {
        "tags": [
          "Content"
        ],
        "summary": "List published posts",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tag",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "featured",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated posts"
          }
        }
      }
    },
    "/posts/featured": {
      "get": {
        "tags": [
          "Content"
        ],
        "summary": "Featured posts",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Featured posts"
          }
        }
      }
    },
    "/posts/trending": {
      "get": {
        "tags": [
          "Content"
        ],
        "summary": "Trending posts by view count",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10
            }
          },
          {
            "name": "days",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 7
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Trending posts"
          }
        }
      }
    },
    "/posts/{slug}": {
      "get": {
        "tags": [
          "Content"
        ],
        "summary": "Get post by slug or id",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "comments",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Post detail including readingTimeMinutes and deliveryType"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/posts/{slug}/download": {
      "get": {
        "tags": [
          "Content"
        ],
        "summary": "Issue a short-lived signed URL for a post file download (public, rate-limited)",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Signed download URL and file metadata. installed is always false."
          },
          "404": {
            "description": "Post or file not found"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/posts/{slug}/bookmark": {
      "post": {
        "tags": [
          "Engagement"
        ],
        "summary": "Bookmark a post",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bookmark created"
          }
        }
      },
      "delete": {
        "tags": [
          "Engagement"
        ],
        "summary": "Remove a bookmark",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bookmark removed"
          }
        }
      }
    },
    "/home": {
      "get": {
        "tags": [
          "Content"
        ],
        "summary": "Home layout sections with hydrated items from posts, software, and sponsored campaigns",
        "responses": {
          "200": {
            "description": "Ordered enabled home sections"
          }
        }
      }
    },
    "/sponsored": {
      "get": {
        "tags": [
          "Ads"
        ],
        "summary": "Active in-window sponsored campaign banners",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sponsored banners"
          }
        }
      }
    },
    "/posts/{id}/views": {
      "post": {
        "tags": [
          "Engagement"
        ],
        "summary": "Record a post view (idempotent via eventKey)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Post id or slug"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "eventKey": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "View recorded or deduped"
          }
        }
      }
    },
    "/posts/{id}/comments": {
      "post": {
        "tags": [
          "Engagement"
        ],
        "summary": "Create a comment",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "body"
                ],
                "properties": {
                  "body": {
                    "type": "string"
                  },
                  "parentId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Comment created"
          }
        }
      }
    },
    "/categories": {
      "get": {
        "tags": [
          "Categories"
        ],
        "summary": "List categories",
        "responses": {
          "200": {
            "description": "Category tree"
          }
        }
      }
    },
    "/categories/{slug}": {
      "get": {
        "tags": [
          "Categories"
        ],
        "summary": "Category detail with posts or software",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "include",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "posts",
                "software"
              ],
              "default": "posts"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Category with items"
          }
        }
      }
    },
    "/software": {
      "get": {
        "tags": [
          "Software"
        ],
        "summary": "List published verified software",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "channel",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "HOSTED_FILE",
                "EXTERNAL_URL",
                "GOOGLE_PLAY"
              ]
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "featured",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "premium",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated software"
          }
        }
      }
    },
    "/software/featured": {
      "get": {
        "tags": [
          "Software"
        ],
        "summary": "Featured software",
        "responses": {
          "200": {
            "description": "Featured software"
          }
        }
      }
    },
    "/software/{slug}": {
      "get": {
        "tags": [
          "Software"
        ],
        "summary": "Software detail by slug or id",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "installedVersionCode",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Client-reported installed version; never inferred from downloads"
          }
        ],
        "responses": {
          "200": {
            "description": "Software detail with distribution channel payload"
          }
        }
      }
    },
    "/software/{id}/versions": {
      "get": {
        "tags": [
          "Software"
        ],
        "summary": "Version history",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Software id or slug"
          }
        ],
        "responses": {
          "200": {
            "description": "Versions"
          }
        }
      }
    },
    "/software/{id}/download": {
      "get": {
        "tags": [
          "Software"
        ],
        "summary": "Issue DownloadGrant / outbound URL (never claims install)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fileId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "versionId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Short-lived download URL or external/store link; installed is always false"
          },
          "403": {
            "description": "Premium required"
          }
        }
      }
    },
    "/software/{id}/reviews": {
      "post": {
        "tags": [
          "Engagement"
        ],
        "summary": "Create or update a review",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "rating"
                ],
                "properties": {
                  "rating": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  },
                  "title": {
                    "type": "string"
                  },
                  "body": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Review saved"
          }
        }
      }
    },
    "/software/{id}/favorite": {
      "post": {
        "tags": [
          "Engagement"
        ],
        "summary": "Toggle favorite",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Favorite toggled"
          }
        }
      }
    },
    "/users/me": {
      "get": {
        "tags": [
          "User"
        ],
        "summary": "Current user profile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Profile"
          }
        }
      },
      "patch": {
        "tags": [
          "User"
        ],
        "summary": "Update profile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "bio": {
                    "type": "string",
                    "nullable": true
                  },
                  "image": {
                    "type": "string",
                    "nullable": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated profile"
          }
        }
      }
    },
    "/users/me/downloads": {
      "get": {
        "tags": [
          "User"
        ],
        "summary": "Download history",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Downloads"
          }
        }
      }
    },
    "/users/me/favorites": {
      "get": {
        "tags": [
          "User"
        ],
        "summary": "Favorite software",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
